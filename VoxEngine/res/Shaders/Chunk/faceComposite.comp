#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba8, binding = 0) uniform image2D opaqueImage;
layout(binding = 1) uniform sampler2D accumulationTex;
layout(binding = 2) uniform sampler2D revealageTex;

void main()
{
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize_ = imageSize(opaqueImage);
    
    if (texelCoord.x >= imageSize_.x || texelCoord.y >= imageSize_.y)
        return;
    
    vec2 uv = (vec2(texelCoord) + 0.5) / vec2(imageSize_);
    
    vec4 accumulation = texture(accumulationTex, uv);
    float revealage = min(texture(revealageTex, uv).r, 1.0);
    vec4 opaque = imageLoad(opaqueImage, texelCoord);
    
    // Composite transparent over opaque
    vec3 averageColor = accumulation.rgb / max(accumulation.a, 1e-5);
    
    // Blend transparent over opaque (opaque.a is either 0 or zero)
    vec4 finalColor;
    finalColor.rgb = mix(opaque.rgb, averageColor, max(revealage, 1.0 - opaque.a));
    finalColor.a = mix(revealage, 1.0, opaque.a);

    imageStore(opaqueImage, texelCoord, finalColor);
}